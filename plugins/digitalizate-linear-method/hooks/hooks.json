{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ll]inear.*__(save_issue|create_issue|update_issue|save_project|create_project|update_project|save_initiative|create_initiative|update_initiative|save_status_update|create_project_update|create_status_update|save_issue_label|create_issue_label|update_issue_label)",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Ll]inear.*__(save_|create_|update_|delete_|archive_)",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/log.mjs\"", "timeout": 15 }
        ]
      }
    ]
  }
}
